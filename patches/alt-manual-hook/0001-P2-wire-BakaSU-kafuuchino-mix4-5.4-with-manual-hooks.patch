From 80e46186957ea9728d05e2f531abe71eb9e3eadd Mon Sep 17 00:00:00 2001
From: kb <kb@local>
Date: Thu, 29 Oct 2026 13:24:16 +0000
Subject: [PATCH 1/3] P2: wire BakaSU (kafuuchino mix4-5.4) with manual hooks

---
 drivers/Kconfig  |  2 ++
 drivers/Makefile |  2 ++
 drivers/kernelsu |  1 +
 fs/exec.c        | 17 +++++++++++++++++
 fs/open.c        |  8 ++++++++
 fs/stat.c        | 16 ++++++++++++++++
 kernel/reboot.c  |  8 ++++++++
 7 files changed, 54 insertions(+)
 create mode 120000 drivers/kernelsu

diff --git a/drivers/Kconfig b/drivers/Kconfig
index 4c39cacfc..c580677b8 100644
--- a/drivers/Kconfig
+++ b/drivers/Kconfig
@@ -238,4 +238,6 @@ source "drivers/vendor/common/Kconfig"
 source "drivers/vendor/soc/sprd/Kconfig"
 source "drivers/nfc/Kconfig"
 source "drivers/nfc/pn553/Kconfig"
+source "drivers/kernelsu/Kconfig"
+
 endmenu
diff --git a/drivers/Makefile b/drivers/Makefile
index 239371138..dbe6f7a84 100644
--- a/drivers/Makefile
+++ b/drivers/Makefile
@@ -190,3 +190,5 @@ obj-$(CONFIG_TRUSTY)		+= trusty/
 obj-$(CONFIG_ARCH_SPRD)         += unisoc_platform/
 obj-$(CONFIG_VENDOR_COMMON_COMPILE)	+= vendor/common/
 obj-$(CONFIG_VENDOR_SOC_SPRD_COMPILE)	+= vendor/soc/sprd/
+
+obj-$(CONFIG_KSU)		+= kernelsu/
diff --git a/drivers/kernelsu b/drivers/kernelsu
new file mode 120000
index 000000000..d17ba5d53
--- /dev/null
+++ b/drivers/kernelsu
@@ -0,0 +1 @@
+../../bakasu-mix4/kernel
\ No newline at end of file
diff --git a/fs/exec.c b/fs/exec.c
index cb39c0eb4..dbc18b124 100644
--- a/fs/exec.c
+++ b/fs/exec.c
@@ -1755,6 +1755,14 @@ static int exec_binprm(struct linux_binprm *bprm)
 /*
  * sys_execve() executes a new program.
  */
+#ifdef CONFIG_KSU_MANUAL_HOOK
+extern int ksu_handle_execveat(int *fd, struct filename **filename_ptr,
+			       void *argv, void *envp, int *flags);
+extern int ksu_handle_post_execveat(int *fd, struct filename **filename_ptr,
+				    void *argv, void *envp, int *flags,
+				    int *retval);
+#endif
+
 static int __do_execve_file(int fd, struct filename *filename,
 			    struct user_arg_ptr argv,
 			    struct user_arg_ptr envp,
@@ -1765,6 +1773,10 @@ static int __do_execve_file(int fd, struct filename *filename,
 	struct files_struct *displaced;
 	int retval;
 
+#ifdef CONFIG_KSU_MANUAL_HOOK
+	if (!IS_ERR_OR_NULL(filename))
+		ksu_handle_execveat(&fd, &filename, &argv, &envp, &flags);
+#endif
 	if (IS_ERR(filename))
 		return PTR_ERR(filename);
 
@@ -1909,6 +1921,11 @@ static int __do_execve_file(int fd, struct filename *filename,
 	if (displaced)
 		reset_files_struct(displaced);
 out_ret:
+#ifdef CONFIG_KSU_MANUAL_HOOK
+	if (filename)
+		ksu_handle_post_execveat(&fd, &filename, &argv, &envp, &flags,
+					 &retval);
+#endif
 	if (filename)
 		putname(filename);
 	return retval;
diff --git a/fs/open.c b/fs/open.c
index edb14e082..8b3b0e53c 100644
--- a/fs/open.c
+++ b/fs/open.c
@@ -440,8 +440,16 @@ long do_faccessat(int dfd, const char __user *filename, int mode)
 	return res;
 }
 
+#ifdef CONFIG_KSU_MANUAL_HOOK
+extern int ksu_handle_faccessat(int *dfd, const char __user **filename_user,
+				int *mode, int *flags);
+#endif
+
 SYSCALL_DEFINE3(faccessat, int, dfd, const char __user *, filename, int, mode)
 {
+#ifdef CONFIG_KSU_MANUAL_HOOK
+	ksu_handle_faccessat(&dfd, &filename, &mode, NULL);
+#endif
 	return do_faccessat(dfd, filename, mode);
 }
 
diff --git a/fs/stat.c b/fs/stat.c
index 268c9eb89..5273e4ca4 100644
--- a/fs/stat.c
+++ b/fs/stat.c
@@ -21,6 +21,12 @@
 #include <linux/uaccess.h>
 #include <asm/unistd.h>
 
+#ifdef CONFIG_KSU_MANUAL_HOOK
+extern int ksu_handle_stat(int *dfd, const char __user **filename_user,
+			   int *flags);
+extern void ksu_handle_vfs_fstat(int fd, loff_t *kstat_size_ptr);
+#endif
+
 /**
  * generic_fillattr - Fill in the basic attributes from the inode struct
  * @inode: Inode to use as the source
@@ -144,6 +150,10 @@ int vfs_statx_fd(unsigned int fd, struct kstat *stat,
 	if (f.file) {
 		error = vfs_getattr(&f.file->f_path, stat,
 				    request_mask, query_flags);
+#ifdef CONFIG_KSU_MANUAL_HOOK
+		if (!error)
+			ksu_handle_vfs_fstat(fd, &stat->size);
+#endif
 		fdput(f);
 	}
 	return error;
@@ -364,6 +374,9 @@ SYSCALL_DEFINE4(newfstatat, int, dfd, const char __user *, filename,
 	struct kstat stat;
 	int error;
 
+#ifdef CONFIG_KSU_MANUAL_HOOK
+	ksu_handle_stat(&dfd, &filename, &flag);
+#endif
 	error = vfs_fstatat(dfd, filename, &stat, flag);
 	if (error)
 		return error;
@@ -515,6 +528,9 @@ SYSCALL_DEFINE4(fstatat64, int, dfd, const char __user *, filename,
 	struct kstat stat;
 	int error;
 
+#ifdef CONFIG_KSU_MANUAL_HOOK /* 32-bit su */
+	ksu_handle_stat(&dfd, &filename, &flag);
+#endif
 	error = vfs_fstatat(dfd, filename, &stat, flag);
 	if (error)
 		return error;
diff --git a/kernel/reboot.c b/kernel/reboot.c
index 8f08af3a7..ee2c1f5d9 100644
--- a/kernel/reboot.c
+++ b/kernel/reboot.c
@@ -310,6 +310,11 @@ DEFINE_MUTEX(system_transition_mutex);
  *
  * reboot doesn't sync: do that yourself before calling this.
  */
+#ifdef CONFIG_KSU_MANUAL_HOOK
+extern int ksu_handle_sys_reboot(int magic1, int magic2, unsigned int cmd,
+				 void __user **arg);
+#endif
+
 SYSCALL_DEFINE4(reboot, int, magic1, int, magic2, unsigned int, cmd,
 		void __user *, arg)
 {
@@ -317,6 +322,9 @@ SYSCALL_DEFINE4(reboot, int, magic1, int, magic2, unsigned int, cmd,
 	char buffer[256];
 	int ret = 0;
 
+#ifdef CONFIG_KSU_MANUAL_HOOK
+	ksu_handle_sys_reboot(magic1, magic2, cmd, &arg);
+#endif
 	/* We only trust the superuser with rebooting the system. */
 	if (!ns_capable(pid_ns->user_ns, CAP_SYS_BOOT))
 		return -EPERM;
-- 
