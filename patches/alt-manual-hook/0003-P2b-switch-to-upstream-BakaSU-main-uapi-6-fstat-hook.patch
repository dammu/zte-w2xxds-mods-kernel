From 51e4ee98d63227533f0b06ea932b11263cddbc5d Mon Sep 17 00:00:00 2001
From: kb <kb@local>
Date: Thu, 29 Oct 2026 14:00:52 +0000
Subject: [PATCH 3/3] P2b: switch to upstream BakaSU main (uapi 6); fstat hooks
 per upstream manual-hook contract

---
 drivers/kernelsu |  2 +-
 fs/stat.c        | 17 ++++++++++++-----
 2 files changed, 13 insertions(+), 6 deletions(-)

diff --git a/drivers/kernelsu b/drivers/kernelsu
index d17ba5d53..6f6c02ae2 120000
--- a/drivers/kernelsu
+++ b/drivers/kernelsu
@@ -1 +1 @@
-../../bakasu-mix4/kernel
\ No newline at end of file
+../../bakasu-upstream/kernel
\ No newline at end of file
diff --git a/fs/stat.c b/fs/stat.c
index 5273e4ca4..019bbc627 100644
--- a/fs/stat.c
+++ b/fs/stat.c
@@ -24,7 +24,12 @@
 #ifdef CONFIG_KSU_MANUAL_HOOK
 extern int ksu_handle_stat(int *dfd, const char __user **filename_user,
 			   int *flags);
-extern void ksu_handle_vfs_fstat(int fd, loff_t *kstat_size_ptr);
+extern void ksu_handle_newfstat_ret(unsigned int *fd,
+				    struct stat __user **statbuf_ptr);
+#if defined(__ARCH_WANT_STAT64) || defined(__ARCH_WANT_COMPAT_STAT64)
+extern void ksu_handle_fstat64_ret(unsigned long *fd,
+				   struct stat64 __user **statbuf_ptr);
+#endif
 #endif
 
 /**
@@ -150,10 +155,6 @@ int vfs_statx_fd(unsigned int fd, struct kstat *stat,
 	if (f.file) {
 		error = vfs_getattr(&f.file->f_path, stat,
 				    request_mask, query_flags);
-#ifdef CONFIG_KSU_MANUAL_HOOK
-		if (!error)
-			ksu_handle_vfs_fstat(fd, &stat->size);
-#endif
 		fdput(f);
 	}
 	return error;
@@ -392,6 +393,9 @@ SYSCALL_DEFINE2(newfstat, unsigned int, fd, struct stat __user *, statbuf)
 	if (!error)
 		error = cp_new_stat(&stat, statbuf);
 
+#ifdef CONFIG_KSU_MANUAL_HOOK
+	ksu_handle_newfstat_ret(&fd, &statbuf);
+#endif
 	return error;
 }
 #endif
@@ -519,6 +523,9 @@ SYSCALL_DEFINE2(fstat64, unsigned long, fd, struct stat64 __user *, statbuf)
 	if (!error)
 		error = cp_new_stat64(&stat, statbuf);
 
+#ifdef CONFIG_KSU_MANUAL_HOOK /* 32-bit */
+	ksu_handle_fstat64_ret(&fd, &statbuf);
+#endif
 	return error;
 }
 
-- 
