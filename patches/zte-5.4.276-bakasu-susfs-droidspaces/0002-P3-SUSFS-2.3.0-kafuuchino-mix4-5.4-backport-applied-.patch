+
+/* 5.4 fsnotify monitor. Built-in SUSFS; Root exit must call stop before
+ * releasing ksu_cred. Callbacks run under fsnotify SRCU, never take either
+ * mutex or destroy a group. Group destruction drains callbacks before cancel. */
+#define SDCARD_ANDROID_PATH "/data/media/0/Android"
+DEFINE_STATIC_KEY_TRUE(susfs_is_sdcard_android_data_not_decrypted);
+static DEFINE_MUTEX(sdcard_control_lock);
+static DEFINE_MUTEX(sdcard_watch_lock);
+static struct task_struct *sdcard_monitor_task;
+static int sdcard_monitor_status = -EINPROGRESS;
+static struct fsnotify_group *g;
+static struct path sdcard_path;
+static struct inode *sdcard_inode;
+static unsigned long sdcard_cleanup_scheduled;
+static struct delayed_work sdcard_cleanup_dwork;
+
+/* Caller holds watch lock. Drop mark group's ownership before inode/path. */
+static void susfs_sdcard_release_watch(void)
+{
+	if (g) {
+		fsnotify_destroy_group(g);
+		g = NULL;
+	}
+	if (sdcard_inode) {
+		iput(sdcard_inode);
+		sdcard_inode = NULL;
+	}
+	if (sdcard_path.mnt) {
+		path_put(&sdcard_path);
+		memset(&sdcard_path, 0, sizeof(sdcard_path));
+	}
+}
+
+static void susfs_sdcard_cleanup_fn(struct work_struct *work)
+{
+	mutex_lock(&sdcard_watch_lock);
+	if (static_key_enabled(&susfs_is_sdcard_android_data_not_decrypted))
+		static_branch_disable(&susfs_is_sdcard_android_data_not_decrypted);
+	susfs_sdcard_release_watch();
+	mutex_unlock(&sdcard_watch_lock);
+}
+
+static int susfs_handle_sdcard_inode_event(struct fsnotify_group *group,
+		struct inode *inode, u32 mask, const void *data, int data_type,
+		const struct qstr *file_name, u32 cookie,
+		struct fsnotify_iter_info *iter_info)
+{
+	struct inode *child;
+	/* Parent inode is the watched /data/media/0. qstr names its child.
+	 * PATH carries the opened child dentry; INODE carries that child inode.
+	 * Ignore unrelated events and directory entries that are not directories.
+	 * Permission notification always returns 0: observer never denies open. */
+	if (!(mask & FS_OPEN_PERM) || !(mask & FS_ISDIR) ||
+		!(mask & FS_EVENT_ON_CHILD) || !file_name ||
+		file_name->len != 7 || memcmp(file_name->name, "Android", 7))
+		return 0;
+	if (data_type == FSNOTIFY_EVENT_PATH) {
+		const struct path *path = data;
+		child = path ? d_backing_inode(path->dentry) : NULL;
+	} else if (data_type == FSNOTIFY_EVENT_INODE) {
+		child = (struct inode *)data;
+	} else {
+		return 0;
+	}
+	if (!child || !S_ISDIR(child->i_mode))
+		return 0;
+	if (!test_and_set_bit(0, &sdcard_cleanup_scheduled))
+		queue_delayed_work(system_unbound_wq, &sdcard_cleanup_dwork, 5 * HZ);
+	return 0;
+}
+
+static void susfs_sdcard_free_mark(struct fsnotify_mark *mark)
+{
+	kfree(mark);
+}
+
+static const struct fsnotify_ops fsnotify_ops = {
+	.handle_event = susfs_handle_sdcard_inode_event,
+	.free_mark = susfs_sdcard_free_mark,
+};
+
+static int susfs_sdcard_monitor_fn(void *data)
+{
+	struct cred *cred;
+	struct fsnotify_mark *mark;
+	int ret;
+	cred = prepare_creds();
+	if (!cred)
+		return -ENOMEM;
+	setup_selinux("u:r:ksu:s0", cred);
+	commit_creds(cred);
+	if (!susfs_is_current_ksu_domain())
+		return -EINVAL;
+	mutex_lock(&sdcard_watch_lock);
+	g = fsnotify_alloc_group(&fsnotify_ops);
+	if (IS_ERR(g)) {
+		ret = PTR_ERR(g);
+		g = NULL;
+		goto out;
+	}
+	ret = kern_path("/data/media/0", LOOKUP_FOLLOW, &sdcard_path);
+	if (ret)
+		goto release;
+	sdcard_inode = d_backing_inode(sdcard_path.dentry);
+	if (!sdcard_inode) {
+		ret = -ENOENT;
+		goto release;
+	}
+	ihold(sdcard_inode);
+	mark = kzalloc(sizeof(*mark), GFP_KERNEL);
+	if (!mark) {
+		ret = -ENOMEM;
+		goto release;
+	}
+	fsnotify_init_mark(mark, g);
+	mark->mask = FS_EVENT_ON_CHILD | FS_ISDIR | FS_OPEN_PERM;
+	ret = fsnotify_add_inode_mark(mark, sdcard_inode, 0);
+	/* add retains group/list reference on success. Drop creator reference on
+	 * both paths; .free_mark runs exactly once after final reference drops. */
+	fsnotify_put_mark(mark);
+	if (ret)
+		goto release;
+	mutex_unlock(&sdcard_watch_lock);
+	return 0;
+release:
+	susfs_sdcard_release_watch();
+out:
+	mutex_unlock(&sdcard_watch_lock);
+	SUSFS_LOGE("sdcard watch setup failed: %d; preserving not-decrypted state\n", ret);
+	return ret;
+}
+
+static int susfs_sdcard_monitor_thread(void *data)
+{
+	int ret = susfs_sdcard_monitor_fn(data);
+	WRITE_ONCE(sdcard_monitor_status, ret);
+	return ret;
+}
+
+void susfs_start_sdcard_monitor_fn(void)
+{
+	struct task_struct *task;
+	mutex_lock(&sdcard_control_lock);
+	if (!static_key_enabled(&susfs_is_sdcard_android_data_not_decrypted))
+		goto out;
+	if (sdcard_monitor_task) {
+		int status = READ_ONCE(sdcard_monitor_status);
+		if (!status || status == -EINPROGRESS)
+			goto out;
+		/* Failed setup may precede /data/media availability. Join/release
+		 * the retained task before retrying on a later boot-stage call. */
+		kthread_stop(sdcard_monitor_task);
+		put_task_struct(sdcard_monitor_task);
+		sdcard_monitor_task = NULL;
+	}
+	clear_bit(0, &sdcard_cleanup_scheduled);
+	task = kthread_create(susfs_sdcard_monitor_thread, NULL, "susfs_sdcard_monitor");
+	if (IS_ERR(task)) {
+		SUSFS_LOGE("sdcard monitor creation failed: %ld\n", PTR_ERR(task));
+		goto out;
+	}
+	/* Retain before wake: fast setup failure may otherwise free task. */
+	get_task_struct(task);
+	sdcard_monitor_task = task;
+	WRITE_ONCE(sdcard_monitor_status, -EINPROGRESS);
+	wake_up_process(task);
+out:
+	mutex_unlock(&sdcard_control_lock);
+}
+
+void susfs_stop_sdcard_monitor_fn(void)
+{
+	mutex_lock(&sdcard_control_lock);
+	if (sdcard_monitor_task) {
+		kthread_stop(sdcard_monitor_task);
+		put_task_struct(sdcard_monitor_task);
+		sdcard_monitor_task = NULL;
+	}
+	mutex_lock(&sdcard_watch_lock);
+	/* Destroy first: no SRCU callback may enqueue after cancel completes. */
+	susfs_sdcard_release_watch();
+	mutex_unlock(&sdcard_watch_lock);
+	cancel_delayed_work_sync(&sdcard_cleanup_dwork);
+	mutex_unlock(&sdcard_control_lock);
+}
+
+// - defer extra susfs works to workqueue after do_umount in ksu_handle_setresuid()
+//   so that we do not block there and reduce the risk of time side channel as much as possible.
+struct work_struct susfs_extra_works;
+static void susfs_run_extra_works(struct work_struct *work) {
+	if (!ksu_cred)
+		return;
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+	susfs_run_sus_path_loop();
+#endif // #ifdef CONFIG_KSU_SUSFS_SUS_PATH
+}
+
+void susfs_shutdown(void)
+{
+	susfs_stop_sdcard_monitor_fn();
+	cancel_work_sync(&susfs_extra_works);
+}
+
+/* susfs_init */
+void susfs_init(void) {
+	BUILD_BUG_ON(BITS_PER_LONG != 64);
+	BUILD_BUG_ON(TIF_PROC_UMOUNTED_FOR_ZYGOTE_NEXT >= BITS_PER_LONG);
+	BUILD_BUG_ON(AS_FLAGS_SUS_MAP >= BITS_PER_LONG);
+	SUSFS_LOGI("Initializing susfs_extra_works\n");
+	INIT_WORK(&susfs_extra_works, susfs_run_extra_works);
+	INIT_DELAYED_WORK(&sdcard_cleanup_dwork, susfs_sdcard_cleanup_fn);
+	SUSFS_LOGI("susfs is initialized! version: " SUSFS_VERSION " \n");
+}
+
+/* No module exit is needed becuase it should never be a loadable kernel module */
+//void __init susfs_exit(void)
