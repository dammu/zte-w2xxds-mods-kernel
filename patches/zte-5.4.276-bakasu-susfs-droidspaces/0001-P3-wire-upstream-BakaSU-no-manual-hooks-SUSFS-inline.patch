From 85d3cf820fbc79c83d0a711d084f7c03d71d6c9f Mon Sep 17 00:00:00 2001
From: kb <kb@local>
Date: Thu, 29 Oct 2026 15:08:44 +0000
Subject: [PATCH 1/4] P3: wire upstream BakaSU (no manual hooks; SUSFS inline
 mode)

---
 drivers/Kconfig  | 2 ++
 drivers/Makefile | 2 ++
 drivers/kernelsu | 1 +
 3 files changed, 5 insertions(+)
 create mode 120000 drivers/kernelsu

diff --git a/drivers/Kconfig b/drivers/Kconfig
index 4c39cacfc..c580677b8 100644
--- a/drivers/Kconfig
+++ b/drivers/Kconfig
@@ -238,4 +238,6 @@ source "drivers/vendor/common/Kconfig"
 source "drivers/vendor/soc/sprd/Kconfig"
 source "drivers/nfc/Kconfig"
 source "drivers/nfc/pn553/Kconfig"
+source "drivers/kernelsu/Kconfig"
+
 endmenu
diff --git a/drivers/Makefile b/drivers/Makefile
index 239371138..dbe6f7a84 100644
--- a/drivers/Makefile
+++ b/drivers/Makefile
@@ -190,3 +190,5 @@ obj-$(CONFIG_TRUSTY)		+= trusty/
 obj-$(CONFIG_ARCH_SPRD)         += unisoc_platform/
 obj-$(CONFIG_VENDOR_COMMON_COMPILE)	+= vendor/common/
 obj-$(CONFIG_VENDOR_SOC_SPRD_COMPILE)	+= vendor/soc/sprd/
+
+obj-$(CONFIG_KSU)		+= kernelsu/
diff --git a/drivers/kernelsu b/drivers/kernelsu
new file mode 120000
index 000000000..6f6c02ae2
--- /dev/null
+++ b/drivers/kernelsu
@@ -0,0 +1 @@
+../../bakasu-upstream/kernel
\ No newline at end of file
