From 7de1022c82c77fd834508c8f62c45339e75cef9b Mon Sep 17 00:00:00 2001
From: kb <kb@local>
Date: Thu, 29 Oct 2026 15:17:38 +0000
Subject: [PATCH 4/4] P3: show_smap_vma is void on ACK 5.4; post-exec hook uses
 ksu_handle_post_execveat (upstream no longer defines ksu_handle_post_execve)

---
 arch/arm64/configs/w203ds_defconfig | 16 +++++++++++-----
 fs/exec.c                           |  5 +++--
 fs/proc/task_mmu.c                  |  2 +-
 include/linux/odin_ksu_hooks.h      |  2 +-
 4 files changed, 16 insertions(+), 9 deletions(-)

diff --git a/arch/arm64/configs/w203ds_defconfig b/arch/arm64/configs/w203ds_defconfig
index 2ad9f4777..a42be5f09 100644
--- a/arch/arm64/configs/w203ds_defconfig
+++ b/arch/arm64/configs/w203ds_defconfig
@@ -6529,9 +6529,15 @@ CONFIG_KSU_FULL_NAME_FORMAT="%TAG_NAME%-%COMMIT_SHA%"
 # CONFIG_KSU_DISABLE_POLICY is not set
 CONFIG_KSU_MULTI_MANAGER_SUPPORT=y
 # CONFIG_KSU_TRACEPOINT_HOOK is not set
-CONFIG_KSU_MANUAL_HOOK=y
-# CONFIG_KSU_SUSFS is not set
-CONFIG_KSU_MANUAL_HOOK_AUTO_SETUID_HOOK=y
-CONFIG_KSU_MANUAL_HOOK_AUTO_INITRC_HOOK=y
-CONFIG_KSU_MANUAL_HOOK_AUTO_INPUT_HOOK=y
+# CONFIG_KSU_MANUAL_HOOK is not set
+CONFIG_KSU_SUSFS=y
+CONFIG_KSU_SUSFS_SUS_PATH=y
+CONFIG_KSU_SUSFS_SUS_MOUNT=y
+CONFIG_KSU_SUSFS_SUS_KSTAT=y
+CONFIG_KSU_SUSFS_SPOOF_UNAME=y
+CONFIG_KSU_SUSFS_ENABLE_LOG=y
+CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
+CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
+CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
+CONFIG_KSU_SUSFS_SUS_MAP=y
 CONFIG_SYSTEM_TRUSTED_KEYS="certs/zte-oem-module.x509.pem"
diff --git a/fs/exec.c b/fs/exec.c
index ba6c44780..fce5f9a75 100644
--- a/fs/exec.c
+++ b/fs/exec.c
@@ -1897,8 +1897,9 @@ static int __do_execve_file(int fd, struct filename *filename,
 
 #ifdef CONFIG_KSU_SUSFS
 	/* Successful exec, filename still owned. Root consumes marker once. */
-	ksu_handle_post_execve(&fd, filename ? filename->name : NULL,
-			      &argv, &envp, &flags, &retval);
+	if (filename)
+		ksu_handle_post_execveat(&fd, &filename, &argv, &envp, &flags,
+					 &retval);
 #endif
 	/* execve succeeded */
 	current->fs->in_exec = 0;
diff --git a/fs/proc/task_mmu.c b/fs/proc/task_mmu.c
index 492411f08..4f557834f 100644
--- a/fs/proc/task_mmu.c
+++ b/fs/proc/task_mmu.c
@@ -1051,7 +1051,7 @@ static void show_smap_vma(struct seq_file *m, void *v)
 #ifdef CONFIG_KSU_SUSFS_SUS_MAP
 	if (vma->vm_file) {
 		if (SUSFS_IS_INODE_SUS_MAP(file_inode(vma->vm_file)))
-			return 0;
+			return;
 	}
 #endif // #ifdef CONFIG_KSU_SUSFS_SUS_MAP
 
diff --git a/include/linux/odin_ksu_hooks.h b/include/linux/odin_ksu_hooks.h
index deb24a03e..315bc1de8 100644
--- a/include/linux/odin_ksu_hooks.h
+++ b/include/linux/odin_ksu_hooks.h
@@ -9,7 +9,7 @@ struct filename;
 #endif
 #ifdef CONFIG_KSU
 int ksu_handle_execveat(int *fd, struct filename **filename, void *argv, void *envp, int *flags);
-int ksu_handle_post_execve(int *fd, const char *filename, void *argv, void *envp, int *flags, int *retval);
+int ksu_handle_post_execveat(int *fd, struct filename **filename, void *argv, void *envp, int *flags, int *retval);
 int ksu_handle_sys_read(unsigned int fd, char __user **buf_ptr, size_t *count_ptr);
 void ksu_handle_vfs_fstat(int fd, loff_t *size);
 #ifdef CONFIG_KSU_SUSFS
-- 
2.43.0

